{
  "name": "@inkforge/editor-react",
  "version": "0.0.2",
  "description": "React adapter for editor-core.",
  "repository": {
    "type": "git",
    "url": "https://github.com/adisaktimtong/inkforge.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/editor.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./editor.css": "./dist/editor.css",
    "./common-ui": {
      "types": "./dist/common-ui.d.mts",
      "import": "./dist/common-ui.mjs"
    },
    "./engine": {
      "types": "./dist/engine.d.mts",
      "import": "./dist/engine.mjs"
    },
    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs"
    }
  },
  "peerDependencies": {
    "@inkforge/editor-core": "workspace:*",
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20",
    "@adisaktimtong/ui-component": "0.1.0"
  },
  "scripts": {
    "build": "tsdown && cp src/editor.css dist/editor.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@inkforge/editor-html": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@adisaktimtong/ui-component": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adisaktimtong/ui-component": "file:../../artifacts/build-inputs/ui-component-0.1.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
