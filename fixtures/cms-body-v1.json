{
  "version": "0.2.0",
  "profileId": "cms-body-v1",
  "status": "Normative CMS input fixtures. Server assertions run in tests/contracts/cms-profile.test.mjs; browser and Go parity remain separate gates.",
  "allowedTags": [
    "p",
    "h2",
    "h3",
    "h4",
    "ul",
    "ol",
    "li",
    "strong",
    "em",
    "u",
    "s",
    "code",
    "br",
    "a",
    "span"
  ],
  "allowedTokenClasses": ["rte-typo-body", "rte-typo-lead", "rte-text-brand"],
  "contextRules": [
    "Class names must be registered; prefix alone does not grant acceptance",
    "Target _blank requires safe rel output and faithful round-trip",
    "Unsupported or truncated input is not silently saved",
    "Host decision occurs before destructive normalization",
    "All fixture URLs are reserved example data; no remote fetch implied",
    "Stored cms-ref and cms-route must follow link-reference-v0.1 and round-trip through public profile API",
    "Go verifies ownership/locale/current public eligibility separately; syntax fixture is not authorization proof"
  ],
  "fixtures": [
    {
      "id": "HTML-01",
      "title": "Thai paragraph and strong",
      "inputHtml": "<p>สวัสดี <strong>โลก</strong></p>",
      "hostDecision": "accept",
      "canonicalHtml": "<p>สวัสดี <strong>โลก</strong></p>",
      "requiredCapabilityIds": ["CAP-HTML"]
    },
    {
      "id": "HTML-02",
      "title": "Normalize supported bold alias",
